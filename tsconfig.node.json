{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "exclude": [
    "src/**/__tests__/**"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  },
  "references": [
    { "path": "./packages/core-types" },
    { "path": "./packages/config-store" },
    { "path": "./packages/secret-store" },
    { "path": "./packages/airouter" },
    { "path": "./packages/file-dialog" },
    { "path": "./packages/file-store" }
  ]
}
