{
  "name": "cyez-ls101",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "yarn test:scripts && yarn test:vitest && yarn test:playwright && yarn test:product-docs:run",
    "test:scripts": "node --test scripts/__tests__/*.test.js",
    "test:vitest": "vitest run",
    "test:playwright": "yarn build:test && yarn test:playwright:run",
    "test:playwright:run": "yarn test:playwright:electron && yarn test:playwright:components",
    "test:playwright:electron": "playwright test --config=playwright.config.ts",
    "test:playwright:components": "playwright test --config=playwright.components.config.ts",
    "test:product-docs": "yarn build:test && yarn test:product-docs:run",
    "test:product-docs:run": "node scripts/run-product-docs.mjs preview",
    "test:product-docs:preview": "playwright test --config=playwright.product-docs.config.ts",
    "docs:playwright-inventory": "node scripts/generate-playwright-inventory.mjs",
    "docs:product:image": "node scripts/product-docs/docker.mjs build",
    "docs:product:publish": "node scripts/product-docs/docker.mjs publish",
    "docs:product:check": "node scripts/product-docs/docker.mjs check",
    "docs:product:publish:container": "node scripts/product-docs/container-runner.mjs publish",
    "test:smoke": "yarn build:test && playwright test --config=playwright.config.ts tests/integration/electron-app.spec.ts",
    "test:pronunciation": "node scripts/test-pronunciation.js",
    "airouter:catalog:update": "node scripts/airouter/update-model-catalog.mjs --update",
    "airouter:catalog:check": "node scripts/airouter/update-model-catalog.mjs --check",
    "qwen-tts:build-runtime": "node scripts/qwen-tts/build-runtime.mjs",
    "qwen-tts:design-voice": "python scripts/qwen-tts/design-voice.py",
    "qwen-tts:build-package": "node scripts/qwen-tts/build-package.mjs",
    "qwen-tts:download": "node scripts/qwen-tts/download-release-assets.mjs",
    "qwen-tts:prepare": "node scripts/qwen-tts/prepare-package.mjs",
    "qwen-asr:build-package": "node scripts/build-asr-model-package.mjs",
    "pronunciation:build-extension": "node scripts/build-pronunciation-extension-package.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "electron-vite preview",
    "dev": "yarn run predev && chcp 65001 && electron-vite dev",
    "dev:no-setup": "chcp 65001 && electron-vite dev",
    "dev:docker": "yarn run predev && xvfb-run -a electron-vite dev --noSandbox -- --password-store=gnome-libsecret",
    "build": "yarn run prebuild && yarn run lint && yarn run typecheck && electron-vite build",
    "setup": "node scripts/setup.js",
    "postinstall": "electron-builder install-app-deps && node scripts/setup.js",
    "predev": "node scripts/setup.js",
    "prebuild": "node scripts/setup.js",
    "build:test": "node build.js --local --dir --current-platform --skip-model-package",
    "build:dir": "node build.js --local --dir",
    "build:dir:linux": "node build.js --local --dir --linux",
    "build:unpack": "node build.js --local --dir",
    "build:win": "node build.js --local --win",
    "build:linux": "node build.js --local --linux",
    "build:dev": "node build.js --dev",
    "build:nightly": "node build.js --nightly",
    "build:release": "node build.js --release"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "sherpa-onnx-node": "^1.13.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^39.2.6",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "3.8.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependenciesMeta": {
    "electron": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "ffmpeg-static": {
      "built": true
    },
    "onnxruntime-node": {
      "built": true
    }
  },
  "packageManager": "yarn@4.15.0"
}
